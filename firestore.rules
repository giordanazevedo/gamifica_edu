// firestore.rules - Cole este conteúdo no Console Firebase
// Firestore Database → Regras

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuários: só o próprio user pode escrever no seu perfil
    // Mas qualquer usuário autenticado pode LER para o ranking
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Salas de batalha 1v1 em tempo real.
    // Leitura liberada para a busca rápida encontrar salas abertas;
    // só os participantes (ou quem entra numa sala de busca rápida vazia) podem alterar.
    match /battles/{battleId} {
      function isParticipant() {
        return resource.data.player1.uid == request.auth.uid
          || (resource.data.player2 != null && resource.data.player2.uid == request.auth.uid);
      }
      function isJoiningQuickMatch() {
        return resource.data.status == 'waiting_quickmatch'
          && resource.data.player2 == null
          && request.resource.data.player2.uid == request.auth.uid;
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.player1.uid == request.auth.uid;
      allow update: if request.auth != null && (isParticipant() || isJoiningQuickMatch());
      allow delete: if false;
    }

    // Convites de duelo entre amigos: só quem enviou ou quem recebeu
    match /invites/{inviteId} {
      allow read, update: if request.auth != null
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow delete: if false;
    }

    // Salas de Stop multiplayer (cada sala suporta até 8 participantes).
    match /stopRooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() == 1
        && request.resource.data.status == 'waiting';
      allow update: if request.auth != null
        && (
          resource.data.players[request.auth.uid] != null
          || request.resource.data.players[request.auth.uid] != null
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'status', 'letter', 'round', 'deadline', 'hostUid'
        ])
        && request.resource.data.players.size() <= 8
        && request.resource.data.code == resource.data.code;
      allow delete: if false;
    }
  }
}
